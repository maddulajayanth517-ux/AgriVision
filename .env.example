OPENAI_API_KEY=your_openai_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
MAPBOX_SECRET_TOKEN=your_mapbox_secret_token_here # optional; free fallback uses OpenStreetMap/Nominatim
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/your-db-name?retryWrites=true&w=majority
AUTH_SECRET=replace-with-a-secure-random-string

# Get an OpenAI key at https://platform.openai.com/api-keys
# Get an OpenWeather key at https://home.openweathermap.org/api_keys
# Get a Mapbox token at https://account.mapbox.com/
# Copy this file to .env.local and restart: npm run dev
